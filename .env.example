# Copy this file to .env.local for local development, and set the same
# values as Environment Variables in your Vercel project for production.

# Postgres connection string — works with any standard Postgres provider
# (Neon, Supabase, RDS, etc). Vercel's Storage tab integrations usually
# inject this automatically as DATABASE_URL (or POSTGRES_URL). For
# `npm run db:migrate`, prefer a direct/non-pooled connection string if your
# provider distinguishes one (e.g. Supabase's POSTGRES_URL_NON_POOLING) —
# schema changes are more reliable outside a transaction-mode pooler.
#
# Supabase gotcha: the bare direct DB host (db.<ref>.supabase.co) is
# IPv6-only on new projects, which Vercel's runtime cannot reach — every
# query will time out even though the connection string looks correct. Use
# the Supavisor pooler host instead (aws-<region>.pooler.supabase.com),
# which has an IPv4 address: port 5432 for session mode (behaves like a
# direct connection — use this for DATABASE_URL / POSTGRES_URL_NON_POOLING),
# port 6543 for transaction mode (better for concurrent serverless
# functions — use this for POSTGRES_URL if your provider sets it).
DATABASE_URL=

# Supabase Storage — media uploads (hero video/image, location photos,
# trusted-brand logos). All three values are on your Supabase project's
# Settings -> API page. The storage bucket itself is created automatically
# on first upload, so no separate setup step is needed there.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# The password used to sign in at /admin. Choose something strong.
ADMIN_PASSWORD=

# Random secret used to sign admin session cookies. Generate one with:
#   openssl rand -base64 32
ADMIN_SESSION_SECRET=

# Optional — enables the contact form to actually send email (from resend.com).
# Without these, submissions are still accepted and stored, just not emailed.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CONTACT_EMAIL=
