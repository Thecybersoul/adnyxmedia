# Copy this file to .env.local for local development, and set the same
# values as Environment Variables in your Vercel project for production.

# Postgres connection string. Vercel's "Neon" storage integration (or any
# Postgres provider) will give you this — attach it in your Vercel project's
# Storage tab and it's usually injected automatically as DATABASE_URL.
DATABASE_URL=

# Vercel Blob read/write token, from a Blob store created in your Vercel
# project's Storage tab (Storage -> Create Database -> Blob).
BLOB_READ_WRITE_TOKEN=

# The password used to sign in at /admin. Choose something strong.
ADMIN_PASSWORD=

# Random secret used to sign admin session cookies. Generate one with:
#   openssl rand -base64 32
ADMIN_SESSION_SECRET=
