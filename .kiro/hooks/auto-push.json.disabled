{
  "_disabled": "Renamed to .disabled on 2026-08-10 to stop auto-pushing straight to main on every file save — it was racing with other concurrent work on this branch. Rename back to auto-push.json to re-enable.",
  "version": "v1",
  "hooks": [
    {
      "name": "Auto Push to Main",
      "trigger": "PostFileSave",
      "description": "Automatically push commits to main branch after file saves",
      "action": {
        "type": "command",
        "command": "git add -A && git commit -m \"Auto-save: $(date +%Y-%m-%d_%H:%M:%S)\" && git push origin main 2>&1 || echo 'No changes to commit'",
        "timeout": 30
      }
    }
  ]
}